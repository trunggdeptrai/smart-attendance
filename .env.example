# Sao chep thanh .env (KHONG commit .env). Cac bien deu tuy chon.
# Thu muc goc chua du lieu (attendance.db, data/faces, models, backups, research_logs).
# Mac dinh: thu muc du an. Nen dat ra ngoai thu muc ma nguon khi trien khai.
SMART_ATTENDANCE_DATA_ROOT=
# Duong dan rieng cho tep SQLite (mac dinh: <DATA_ROOT>/attendance.db)
SMART_ATTENDANCE_DB=
# Ghi nhat ky nghien cuu (1 = bat, 0 = tat). Nhat ky khong chua anh/vector khuon mat.
SMART_ATTENDANCE_RESEARCH_LOG=1
