# ============================================================
# Smart Attendance - các tệp KHÔNG đưa lên GitHub
# Dữ liệu học sinh, ảnh khuôn mặt, mô hình, mật khẩu và bản sao lưu
# chỉ lưu trên máy sử dụng.
# ============================================================

# --- Môi trường Python và bộ nhớ đệm ---
.venv*/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Cơ sở dữ liệu (chứa thông tin học sinh) ---
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# --- Ảnh khuôn mặt, tập dữ liệu và mô hình nhận diện ---
data/faces/*
!data/faces/.gitkeep
data/eval/
dataset_faces/
models/
*.pkl
*.npy
*.npz

# --- Mật khẩu, khóa và biến môi trường ---
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key

# --- Bản sao lưu và dữ liệu sinh ra khi chạy ---
backups/
database_backups/
attendance.backup*
*.bak
*.backup
*.zip
*.rar
*.7z
*.bundle
*.patch
research_logs/
research_results/
_LUU_TRU*/
_BACKUP*/

# --- Tệp tạm và nhật ký ---
scratch*
*.tmp
*.log
~$*

# --- Trình soạn thảo và hệ điều hành ---
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
desktop.ini
